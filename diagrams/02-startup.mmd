---
title: 2. Startup (world.gd _ready)
---
flowchart TD
    A([Game starts]) --> NET["Create Network node<br/>read command line:<br/>--host / --join ip / --name"]
    NET --> J{"--join?"}
    J -- yes --> J1["Connect to host<br/>(processing paused)"]
    J1 --> J2{"Host's world<br/>settings arrived?"}
    J2 -- "no: failed" --> B
    J2 -- yes --> J3["save_path = '' (the host's world)<br/>set_world_settings(host's)<br/>terrain.open_world()"]
    J3 --> J4["Apply the host's edited chunks<br/>set_chunk_data() as they arrive"]
    J4 --> J5["Spawn next to the host"]
    J -- no --> B["terrain.open_world()<br/>load save or generate world<br/>(all chunks, in parallel)"]
    B --> C{"Saved player<br/>position?"}
    C -- yes --> D[Restore camera]
    C -- no --> E["find_island near origin<br/>spawn beside it, look at it"]
    D & E & J5 --> F["Set terrain.gravity"]
    F --> G["_make_player()<br/>DensityCharacter3D capsule"]
    G --> H["BouncyBalls.new()<br/>load objects.cfg (not when joined)"]
    H --> I["Read material names<br/>build colour picker panel"]
    I --> OE["Create ObjectEditor"]
    OE --> K["Load block textures (Texture2DArray)<br/>+ water texture into shader"]
    K --> L["terrain.update_view(camera)<br/>build + upload clipmap"]
    L --> M["Fit screen, make symmetry visuals"]
    M --> H2{"--host?"}
    H2 -- yes --> H3["network.start_host()<br/>ENet server, default port 24565"]
    H2 -- no --> N
    H3 --> N([Running])
